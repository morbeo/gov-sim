{
  "uid": "bgfin-health",
  "title": "Data freshness and collection health",
  "description": "",
  "tags": [
    "bgfin"
  ],
  "timezone": "browser",
  "style": "light",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Stale series",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT now() AS time, count(*) FILTER (WHERE is_stale) AS value FROM v_freshness"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Open data-quality issues",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT now() AS time, count(*) AS value FROM quality_issue WHERE resolved_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed runs, 7 days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT now() AS time, count(*) AS value FROM collection_run WHERE status = 'failed' AND started_at > now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Stored observation versions",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT now() AS time, count(*) AS value FROM observation"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Sources",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source_code AS source, name, enabled, interval_hours, last_run_at, last_status, last_success_at, failures_7d, last_message FROM v_source_health ORDER BY source_code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Observations written per run",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', started_at) AS time, sum(obs_new) AS value, 'new' AS metric FROM collection_run WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', started_at) AS time, sum(obs_revised) AS value, 'revised' AS metric FROM collection_run WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "drawStyle": "bars",
            "axisCenteredZero": false
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^BG.*"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Recent collection runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT id, source_code AS source, mode, started_at, finished_at - started_at AS duration, status, requests, series_seen, obs_new, obs_revised, message FROM collection_run ORDER BY started_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Stale series",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT f.source_code AS source, f.indicator_code, f.geo, f.source_key, f.latest_period, f.days_since_period_end, f.max_lag_days FROM v_freshness f WHERE is_stale ORDER BY days_since_period_end DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Open data-quality issues",
      "description": "Resolve after review with: bgfin issues --resolve ID",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT q.id, q.severity, q.check_name, coalesce(s.source_code, q.source_code) AS source, s.indicator_code, s.geo, q.period, q.detail::text AS detail, q.first_detected_at FROM quality_issue q LEFT JOIN series s ON s.id = q.series_id WHERE q.resolved_at IS NULL ORDER BY q.first_detected_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Revisions in the last 30 days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT retrieved_at, source_code AS source, indicator_code, geo, period_label AS period, vintage, previous_value, new_value, round(delta::numeric, 3) AS delta FROM v_revisions WHERE retrieved_at > now() - interval '30 days' ORDER BY retrieved_at DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "id": 10
    }
  ],
