    {
      "type": "table",
      "title": "Threshold status (config/alerts.yaml)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name, description, period_label AS period, round(observed::numeric, 2) AS observed,\n       operator || ' ' || threshold AS rule, breached FROM v_threshold_status ORDER BY breached DESC, name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "breached"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "orange",
                        "text": "breached"
                      },
                      "false": {
                        "color": "green",
                        "text": "ok"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 24,
        "h": 10
      },
