    {
      "type": "timeseries",
      "title": "Real GDP growth, y/y",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT period::timestamptz AS time, value, geo AS metric FROM v_indicator_values WHERE indicator_code = 'gdp_growth' AND frequency = 'Q' AND role = 'primary' AND vintage = '' AND geo IN ('BG', 'EA21', 'EU27_2020', 'EA') AND $__timeFilter(period) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "drawStyle": "line",
            "axisCenteredZero": false
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^BG.*"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
