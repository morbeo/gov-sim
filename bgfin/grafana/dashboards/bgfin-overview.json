    {
      "type": "table",
      "title": "Latest observations, Bulgaria",
      "description": "Most recent value of every indicator at its canonical frequency. Changes are differences (percentage points for rates).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bgfin-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bgfin-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "\nSELECT DISTINCT ON (c.indicator_code) i.category, i.name AS indicator, c.period_label AS period,\n       round(c.value::numeric, 2) AS value, round(c.pop_diff::numeric, 2) AS \"change vs previous\",\n       round(c.yoy_diff::numeric, 2) AS \"change vs year ago\", c.unit, c.source_code AS source, c.obs_type AS status\nFROM v_changes c JOIN indicator i ON i.code = c.indicator_code\nWHERE c.geo = 'BG' AND c.role IN ('primary', 'benchmark') AND c.frequency = i.frequency AND c.value IS NOT NULL\nORDER BY c.indicator_code, c.period DESC, (c.role = 'primary') DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 18
      },
      "id": 13
    },
